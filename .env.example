# Скопируй этот файл в .env и заполни своими данными.

# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# Твой Telegram ID (админ). Узнать можно у @userinfobot
ADMIN_ID=123456789

# Услуги и закреплённые за ними специалисты (ID друзей).
# Если operator_id не указан или равен 0 — чат уйдёт админу.
SERVICES_JSON='[{"key":"site","title":"🌐 Разработка сайта","operator_id":123456789},{"key":"bot","title":"🤖 Telegram-бот","operator_id":987654321},{"key":"design","title":"🎨 Дизайн и вёрстка","operator_id":987654321}]'

# Путь к базе. На Fly.io смонтирован том /data — оставь как есть.
DB_PATH=data/bot.db

# Секрет для webhook (любая случайная строка)
WEBHOOK_SECRET=change-me-to-random-string

# Локальный тест: WEBHOOK_URL оставь пустым → бот работает в polling.
# На Render/Fly заполняется автоматически через RENDER_EXTERNAL_URL / FLY_APP_URL.
WEBHOOK_URL=
PORT=8080

# Внешняя база Turso (бесплатно). Если заполнено — история и статистика
# сохраняются при перезапуске Render. Получить из https://app.turso.tech:
# TURSO_DATABASE_URL=libsql://твоя-база-организация.turso.io
# TURSO_AUTH_TOKEN=...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Бесплатный ключ Gemini: https://aistudio.google.com/api-keys
# Нужен для кнопки «🧠 Собрать ТЗ». Без ключа кнопка просто сообщит об этом.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
